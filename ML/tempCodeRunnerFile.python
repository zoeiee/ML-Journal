# ============================================================
# CELL 11: CONVOLUTION BLOCK
# ============================================================

class ConvBlock(nn.Module):

    def __init__(
        self,
        in_channels,
        out_channels,
        dropout=0.0
    ):

        super().__init__()


        self.block = nn.Sequential(

            # First convolution
            nn.Conv2d(
                in_channels,
                out_channels,
                kernel_size=3,
                padding=1,
                bias=False
            ),

            # Batch normalization
            nn.BatchNorm2d(
                out_channels
            ),

            # Activation
            nn.ReLU(
                inplace=True
            ),


            # Second convolution
            nn.Conv2d(
                out_channels,
                out_channels,
                kernel_size=3,
                padding=1,
                bias=False
            ),

            nn.BatchNorm2d(
                out_channels
            ),

            nn.ReLU(
                inplace=True
            ),


            # Reduce spatial dimensions
            nn.MaxPool2d(
                kernel_size=2,
                stride=2
            ),


            # Regularization
            nn.Dropout(
                p=dropout
            )
        )


    def forward(self, x):

        return self.block(x)